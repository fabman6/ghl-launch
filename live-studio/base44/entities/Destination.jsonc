{
  "name": "Destination",
  "type": "object",
  "title": "Stream Destination",
  "description": "Where a live broadcast goes. YouTube uses the connected account (a broadcast and key are created automatically each time); other platforms use an RTMP(S) server + stream key, or a WHIP endpoint.",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "platform": {
      "type": "string",
      "enum": [
        "youtube",
        "facebook",
        "twitch",
        "linkedin",
        "x",
        "kick",
        "instagram",
        "custom_rtmp",
        "whip"
      ],
      "default": "youtube"
    },
    "connection": {
      "type": "string",
      "enum": [
        "account",
        "key"
      ],
      "default": "key",
      "description": "account = created automatically through the connected platform account; key = server URL + stream key."
    },
    "privacy": {
      "type": "string",
      "enum": [
        "public",
        "unlisted",
        "private"
      ],
      "default": "public"
    },
    "rtmp_url": {
      "type": "string"
    },
    "stream_key": {
      "type": "string"
    },
    "key_each_time": {
      "type": "boolean",
      "default": false,
      "description": "Platform issues a new key for every broadcast (Instagram, LinkedIn)."
    },
    "whip_url": {
      "type": "string"
    },
    "whip_token": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "platform"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}